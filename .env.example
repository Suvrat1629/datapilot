# Copy to .env and fill in. Never commit .env.

# Postgres (dev-only passwords, match docker-compose.yml and db/init/)
ADMIN_DATABASE_URL=postgresql://datapilot:datapilot@localhost:5432/datapilot
DATABASE_URL=postgresql://datapilot_ro:datapilot_ro@localhost:5432/datapilot
ETL_DATABASE_URL=postgresql://datapilot_etl:datapilot_etl@localhost:5432/datapilot

# LLM tiers as provider:model (providers: groq, google). Verify model names in provider docs.
LLM_LOW=groq:llama-3.1-8b-instant
LLM_HIGH=google:gemini-flash-latest
GROQ_API_KEY=
GOOGLE_API_KEY=

# Limits
MAX_SQL_RETRIES=2
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=10000
MAX_LLM_CALLS_PER_REQUEST=12
ETL_ALLOWED_HOSTS=api.open-meteo.com  # comma-separated; empty = deny all
# Optional. Demo hints are bundled; for your own database point this at your own file.
HINTS_PATH=src/datapilot/demo/hints.yaml

# Langfuse (self-hosted; create a project in the UI at :3001 and paste keys). Skipped if unset.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
